{
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "dev_mode": true,
    "vite_dev_url": "http://localhost:5173"
  },
  "llm": {
    "api_key": "",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "temperature": 0.3,
    "max_tokens": 4096,
    "request_interval": 1.5,
    "max_concurrency": 5
  },
  "http": {
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36"
  },
  "features": {
    "typo_check": {
      "enabled": true,
      "batch_size": 5
    },
    "expression_opt": {
      "enabled": true,
      "batch_size": 3,
      "default_prompt": "请优化以下段落的学术表达，使其更加专业、简洁、逻辑严密。只修改纯文本部分，不要修改任何 marker 标记符和数学公式占位符。",
      "custom_prompts_dir": "prompts/expression/"
    },
    "formula_ocr": {
      "enabled": true,
      "max_image_size_mb": 10
    },
    "table_ocr": {
      "enabled": true,
      "max_image_size_mb": 10
    },
    "template_gen": {
      "enabled": true,
      "output_dir": "templates/",
      "agent_enabled": true,
      "agent_max_rounds": 30,
      "agent_max_files": 30,
      "agent_max_file_size_kb": 512,
      "agent_compile_enabled": true,
      "agent_compile_timeout": 120,
      "cleanup_enabled": true,
      "cleanup_interval_seconds": 3600,
      "cleanup_retention_days": 7
    },
    "code_review": {
      "enabled": true,
      "batch_size": 5
    },
    "compile": {
      "enabled": true,
      "latexmk_timeout": 120,
      "engine": "pdflatex",
      "pdfa": true
    },
    "git_diff": {
      "enabled": true,
      "default_engine": "difflib",
      "default_markup_type": "UNDERLINE",
      "default_math_markup": "fine",
      "default_color_add": "#D7E8B1",
      "default_color_del": "#FFA3A3"
    },
    "format_converter": {
      "enabled": true,
      "allowed_extensions": [".md", ".markdown", ".html", ".htm", ".docx"],
      "max_file_size_mb": 20
    },
    "style_modify": {
      "enabled": true
    },
    "terminology_check": {
      "enabled": true,
      "batch_size": 5
    },
    "paragraph_translate": {
      "enabled": true,
      "batch_size": 5
    },
    "writing_chat": {
      "enabled": true,
      "compression_threshold_tokens": 200000,
      "sessions_dir": "writing_chat_sessions/",
      "custom_prompts_dir": "prompts/writing_chat/",
      "summary_temperature": 0.2,
      "summary_max_tokens": 1024,
      "web_search_enabled": true
    },
    "bib_manager": {
      "enabled": true,
      "format_configs_dir": "formats/",
      "providers": {
        "crossref": { "enabled": true },
        "arxiv": { "enabled": true },
        "datacite": { "enabled": true },
        "openalex": { "enabled": false },
        "europepmc": { "enabled": false },
        "semantic_scholar": { "enabled": false }
      }
    },
    "function_calling": {
      "project_tools": {
        "enabled": true
      },
      "web_search": {
        "enabled": true,
        "engines": {
          "duckduckgo": {
            "enabled": true
          },
          "searxng": {
            "enabled": false,
            "base_url": "http://localhost:8080"
          }
        },
        "primary_engine": "duckduckgo",
        "max_results": 5,
        "timeout_seconds": 10,
        "deep_read_pages": 2,
        "deep_read_max_chars": 4000,
        "query_rewriting": {
          "enabled": true
        }
      }
    }
  },
  "logging": {
    "level": "DEBUG",
    "dir": "logs/"
  }
}
