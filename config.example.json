{
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "dev_mode": true,
    "vite_dev_url": "http://localhost:5173"
  },
  "llm": {
    "api_key": "tk-iwonttellyou",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "temperature": 0.3,
    "max_tokens": 4096,
    "request_interval": 1.5
  },
  "project": {
    "default_open_dir": "C:\\Users\\YourName\\paper",
    "backup_on_modify": true,
    "auto_save_interval": 120
  },
  "features": {
    "typo_check": {
      "enabled": true,
      "batch_size": 5,
      "custom_prompts_dir": "prompts/typo/"
    },
    "expression_opt": {
      "enabled": true,
      "batch_size": 3,
      "default_prompt": "请优化以下段落的学术表达，使其更加专业、简洁、逻辑严密。只修改纯文本部分，不要修改任何 marker 标记符和数学公式占位符。",
      "custom_prompts_dir": "prompts/expression/"
    },
    "formula_ocr": {
      "enabled": true,
      "max_image_size_mb": 10
    },
    "table_ocr": {
      "enabled": true,
      "max_image_size_mb": 10
    },
    "template_gen": {
      "enabled": true,
      "output_dir": "templates/"
    },
    "formatting": {
      "enabled": true,
      "batch_size": 5
    },
    "compile": {
      "enabled": true,
      "latexmk_timeout": 120
    },
    "markdown_converter": {
      "enabled": true
    }
  },
  "logging": {
    "level": "DEBUG",
    "dir": "logs/"
  }
}
