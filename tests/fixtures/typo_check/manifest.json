{
  "description": "错字查找人工评估语料（非 pytest 自动测试）。每条一个 LaTeX 段落片段（不含空行，恰好一个段落），manifest 标注难度分层与期望发现的错字；has_typo=false 的条目用于评估误报率。",
  "items": [
    {
      "id": "typo_01",
      "file": "typo_01.tex",
      "tier": 1,
      "tier_name": "简单错字",
      "title": "英文常见拼写错误",
      "has_typo": true,
      "expected_issues": [
        { "original": "recieve", "corrected": "receive" },
        { "original": "seperates", "corrected": "separates" }
      ]
    },
    {
      "id": "typo_02",
