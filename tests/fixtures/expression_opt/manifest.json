      "file": "expr_01.tex",
      "tier": 1,
      "tier_name": "简单冗余",
      "title": "赘余短语（in order to / a large number of）",
      "has_improvement": true,
      "expected_improvements": [
        { "original": "In order to evaluate", "optimized": "To evaluate" },
        { "original": "a large number of", "optimized": "many" }
      ]
    },
