# LaTeXcellence 环境变量模板
#
# 使用：复制本文件为 `.env`，按需取消注释并填值。
# 规则：真实环境变量优先于 .env 文件（.env 只补缺）；完整说明见 docs/deployment.md「环境变量参考」。

# ── LLM API Key（优先于 config.json 的 llm.api_key，永不写盘）──
# LX_LLM_KEY=

# ── 多用户模式：首个管理员引导凭证（仅用户表为空时消费）──
# LATEXCELLENCE_ADMIN_USERNAME=admin
# LATEXCELLENCE_ADMIN_PASSWORD=

# ── SMTP 授权密码（优先于 config.json 的 smtp.password，永不写盘）──
# LATEXCELLENCE_SMTP_PASSWORD=

# ── Tavily 联网搜索 API Key（优先于配置文件，永不写盘）──
# LATEXCELLENCE_TAVILY_API_KEY=

# ── 学术数据源 API Key（优先于配置文件，永不写盘）──
# LATEXCELLENCE_OPENALEX_API_KEY=
# LATEXCELLENCE_SEMANTIC_SCHOLAR_API_KEY=
# LATEXCELLENCE_CORE_API_KEY=
# LATEXCELLENCE_UNPAYWALL_API_KEY=
# LATEXCELLENCE_PUBMED_API_KEY=

# ── 容器 / 多实例部署（通常在 compose / systemd 中注入，一般无需写入 .env）──
# LATEXCELLENCE_LOG_STDOUT=1
# LATEXCELLENCE_SANDBOX_REPLICA_ID=

# ── 维护者离线评测工具（tools/）──
# TEXLIVE_BIN=/usr/local/texlive/2025/bin/x86_64-linux
# LX_REVIEW_LLM_MODEL=
# LX_REVIEW_LLM_BASE_URL=
# LX_REVIEW_LLM_KEY=
