{
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "dev_mode": true,
    "vite_dev_url": "http://localhost:5173",
    "allowed_origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "https://latexcellence.example.com"
    ]
  },
  "security": {
    "access_token": ""
  },
  "llm": {
    "api_key": "",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "temperature": 0.3,
    "max_tokens": 8192,
    "request_interval": 1.5,
    "max_concurrency": 5,
    "context_window_tokens": 0,
    "models_probe_url": ""
  },
  "http": {
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36"
  },
  "features": {
    "typo_check": {
      "enabled": true,
      "batch_size": 5
    },
    "expression_opt": {
      "enabled": true,
      "batch_size": 3,
      "default_prompt": "请优化以下段落的学术表达，使其更加专业、简洁、逻辑严密。只修改纯文本部分，不要修改任何 marker 标记符和数学公式占位符。",
      "custom_prompts_dir": "data/prompts/expression/"
    },
    "formula_ocr": {
      "enabled": true,
      "max_image_size_mb": 10,
      "format_latex": true
    },
    "table_ocr": {
      "enabled": true,
      "max_image_size_mb": 10,
      "format_latex": true
    },
    "template_gen": {
      "enabled": true,
      "output_dir": "data/templates/",
      "agent_max_rounds": 50,
      "agent_max_files": 30,
      "agent_max_file_size_kb": 512,
      "agent_compile_enabled": true,
      "agent_compile_timeout": 120,
      "cleanup_enabled": true,
      "cleanup_interval_seconds": 3600,
      "cleanup_retention_days": 7
    },
    "code_review": {
      "enabled": true,
      "batch_size": 5
    },
    "compile": {
      "enabled": true,
      "latexmk_timeout": 120,
      "engine": "auto",
      "pdfa": false
    },
    "git_diff": {
      "enabled": true,
      "default_engine": "difflib",
      "default_markup_type": "UNDERLINE",
      "default_math_markup": "fine",
      "default_color_add": "#D7E8B1",
      "default_color_del": "#FFA3A3"
    },
    "format_converter": {
      "enabled": true,
      "allowed_extensions": [".md", ".markdown", ".html", ".htm", ".docx"],
      "max_file_size_mb": 20
    },
    "style_modify": {
      "enabled": true,
      "agent": {
        "enabled": true,
        "sessions_dir": "data/style_modify_sessions/",
        "max_rounds": 20,
        "max_tool_calls": 100,
        "max_compile_runs": 10,
        "max_file_size_kb": 1024,
        "max_session_size_kb": 10240,
        "max_tool_output_chars": 12000,
        "shadow_compile_timeout": 120,
        "allowed_suffixes": [".tex", ".sty", ".cls", ".bib"],
        "cleanup_enabled": true,
        "cleanup_interval_seconds": 3600,
        "cleanup_retention_days": 7
      }
    },
    "terminology_check": {
      "enabled": true,
      "batch_size": 5
    },
    "paragraph_translate": {
      "enabled": true,
      "batch_size": 5
    },
    "writing_chat": {
      "enabled": true,
      "compression_threshold_tokens": 0,
      "compression_headroom_tokens": 30000,
      "compression_keep_recent_tokens": 20000,
      "compression_keep_recent_turns": 5,
      "sessions_dir": "data/writing_chat_sessions/",
      "custom_prompts_dir": "data/prompts/writing_chat/",
      "summary_temperature": 0.2,
      "summary_token_budget": 6000,
      "summary_model": "",
      "web_search_enabled": true,
      "evidence_bundle_enabled": true,
      "evidence_max_chars": 24000,
      "evidence_max_items": 12
    },
    "bib_manager": {
      "enabled": true,
      "format_configs_dir": "data/formats/",
      "providers": {
        "crossref": { "enabled": true },
        "arxiv": { "enabled": true },
        "datacite": { "enabled": true },
        "openalex": { "enabled": false },
        "europepmc": { "enabled": false },
        "semantic_scholar": { "enabled": false }
      }
    },
    "plot_gen": {
      "enabled": true,
      "output_dir": "data/plots/",
      "agent_max_rounds": 20,
      "agent_max_files": 30,
      "agent_max_file_size_kb": 1024,
      "max_data_size_mb": 50,
      "max_data_rows": 1000000,
      "sandbox_exec_timeout": 60,
      "sandbox_max_stdout_chars": 8000,
      "python_interpreter": "",
      "tikz_compile_enabled": true,
      "tikz_compile_timeout": 120,
      "default_style": "nature",
      "cleanup_enabled": true,
      "cleanup_interval_seconds": 3600,
      "cleanup_retention_days": 7
    },
    "function_calling": {
      "web_search": {
        "enabled": false,
        "primary_engine": "tavily",
        "strategy": "legacy",
        "max_results": 10,
        "timeout_seconds": 10,
        "overall_timeout_seconds": 12,
        "per_engine_timeout_seconds": 8,
        "max_parallel_queries": 4,
        "domain_result_cap": 3,
        "engines": {
          "duckduckgo": {
            "enabled": true
          },
          "searxng": {
            "enabled": false,
            "base_url": "http://localhost:8080"
          },
          "tavily": {
            "enabled": true,
            "api_key": ""
          }
        },
        "deep_read_pages": 0,
        "deep_read_max_chars": 10000,
        "query_rewriting": {
          "enabled": true
        },
        "ranking": {
          "mode": "rrf",
          "source_type_boosts": {
            "government": 0.015,
            "official_docs": 0.01,
            "academic": 0.01
          }
        },
        "page_reading": {
          "strategy": "legacy",
          "cache_enabled": true,
          "cache_dir": "data/web_cache/",
          "cache_ttl_seconds": 3600,
          "max_cache_entry_mb": 5,
          "max_response_mb": 10,
          "extractor_version": "html-v1",
          "quality_threshold": 0.35,
          "max_redirects": 5,
          "max_retries": 2,
          "backoff_base_seconds": 0.25,
          "max_retry_after_seconds": 10,
          "per_domain_concurrency": 2,
          "min_domain_interval_ms": 100,
          "circuit_failure_threshold": 3,
          "circuit_cooldown_seconds": 30,
          "browser": {
            "enabled": false,
            "pool_size": 1,
            "page_timeout_seconds": 15,
            "max_pages_per_request": 1,
            "stable_window_ms": 750
          }
        }
      },
      "project_tools": {
        "enabled": true
      },
      "edit_tools": {
        "enabled": true,
        "require_confirmation": true
      },
      "scholarly_research": {
        "enabled": false,
        "primary_source": "openalex",
        "ranking_mode": "legacy",
        "full_text_enabled": false,
        "max_results": 20,
        "timeout_seconds": 30,
        "providers": {
          "openalex": {
            "enabled": true,
            "api_key": ""
          },
          "semantic_scholar": {
            "enabled": false,
            "api_key": ""
          },
          "crossref": {
            "enabled": false,
            "api_key": ""
          },
          "arxiv": {
            "enabled": false,
            "api_key": ""
          },
          "core": {
            "enabled": false,
            "api_key": ""
          },
          "unpaywall": {
            "enabled": false,
            "api_key": ""
          },
          "pubmed": {
            "enabled": false,
            "api_key": ""
          },
          "datacite": {
            "enabled": false,
            "api_key": ""
          }
        }
      }
    }
  },
  "logging": {
    "level": "DEBUG",
    "dir": "logs/"
  }
}
